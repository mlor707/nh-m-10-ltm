# Copy thành .env rồi sửa. KHÔNG commit file .env lên GitHub!
ST_FTPS_HOST=127.0.0.1
ST_FTPS_PORT=2121
ST_FTPS_USER=test
ST_FTPS_PASSWORD=test123
ST_FTPS_VERIFY=false
ST_SSH_HOST=127.0.0.1
ST_SSH_PORT=22
ST_SSH_USER=
ST_SSH_PASSWORD=
ST_SSH_KEY_FILE=
ST_REMOTE_DIR=.
# Required for login tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ST_JWT_SECRET=
# Khóa HMAC cho nhật ký kiểm toán (>= 32 byte). Không đặt thì log chỉ dùng SHA-256, yếu hơn.
# Tạo: python -c "import secrets; print(secrets.token_urlsafe(48))"
ST_AUDIT_KEY=
# Chế độ nghiêm ngặt: chỉ tin máy chủ SSH đã có trong known_hosts (khuyên bật khi chạy thật)
# ST_SSH_STRICT_HOST_KEY=true
# ST_SSH_KNOWN_HOSTS=data/ssh_dev/known_hosts
# ST_SSH_TIMEOUT=20
# ST_SYSLOG_HOST=127.0.0.1
# ST_SYSLOG_PORT=514
