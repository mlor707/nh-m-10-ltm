# Copy thành .env rồi sửa. KHÔNG commit file .env lên GitHub!
ST_FTPS_HOST=127.0.0.1
ST_FTPS_PORT=2121
ST_FTPS_USER=test
ST_FTPS_PASSWORD=test123
ST_FTPS_VERIFY=false
ST_SSH_HOST=127.0.0.1
ST_SSH_PORT=22
ST_SSH_USER=
ST_SSH_PASSWORD=
ST_SSH_KEY_FILE=
ST_REMOTE_DIR=.
